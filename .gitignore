# Large Machine Learning Model Weights & Checkpoints (>100MB)
# (Whisper weights are downloadable via scripts/prepare_offline_models.py)
models/whisper/
models/*.bin
models/*.pt
models/*.safetensors

# Allow lightweight models & ONNX assets (<50MB) to be tracked in Git
!models/*.onnx
!models/silero_vad.onnx
!models/*.gitkeep

